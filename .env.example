# Copy this file to .env and fill in real values:  cp .env.example .env
# Never commit .env. Never put real secrets in this example file.

# ---------- Backend (FastAPI) ----------
APP_NAME="Lesson Content Generator API"
APP_ENV=development
LOG_LEVEL=INFO

# ---------- Supabase ----------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
# Session pooler (IPv4). URL-encode special characters in the password.
DATABASE_URL=postgresql+psycopg://postgres.your-project-ref:YOUR-PASSWORD@aws-0-your-region.pooler.supabase.com:5432/postgres?sslmode=require

# ---------- Local throwaway test database (Docker) ----------
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:54329/lesson_test

# ---------- Frontend (Streamlit) ----------
BACKEND_URL=http://localhost:8000
REQUEST_TIMEOUT_SECONDS=10
